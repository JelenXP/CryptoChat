<?xml version="1.0" encoding="utf-8"?>
<!-- Cesty sdílené přes FileProvider. „camera" = fotka z foťáku, „share" =
     dočasné soubory (zašifrované/dešifrované) k odeslání přes systémové Sdílet. -->
<paths>
    <cache-path name="camera" path="camera/" />
    <cache-path name="share" path="share/" />
    <!-- Přijaté soubory v chatu (video, dokumenty) - otevírají se systémovou appkou. -->
    <files-path name="chat_media" path="chat_media/" />
</paths>
