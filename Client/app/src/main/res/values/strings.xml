    <!-- Add user screen: sections -->
    <string name="section_in_person">In person (QR / copy)</string>
    <string name="section_in_person_description">You\'re next to each other: one creates the key and shows it, the other scans or pastes it.</string>
    <string name="section_remote">Remote (post-quantum secure)</string>
    <string name="section_remote_description">No server needed - exchange two pieces of text over any channel (SMS, email, another app...). Uses ML-KEM, a post-quantum algorithm safe against quantum computers.</string>

    <!-- Invite method (online pairing over relay) -->
    <string name="section_invite">Via invite (over the internet)</string>
    <string name="section_invite_description">Chat through the relay server. Share a one-time code; the server never learns who you are or what you write. Key exchange is post-quantum (ML-KEM).</string>
